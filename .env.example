# Copy to .env.local for local development. Never commit real values.

NEXT_PUBLIC_SITE_URL=https://strobehq.com

# Postgres. Neon URLs (*.neon.tech) use Neon's HTTP driver; any other URL
# (a local Postgres, for example) uses node-postgres. Run `pnpm db:migrate` after setting it.
DATABASE_URL=

# Resend. Without RESEND_API_KEY the form still saves leads and logs that emails were skipped.
RESEND_API_KEY=
RESEND_FROM="Lucas at Strobe <lucas@strobehq.com>"
LEADS_NOTIFY_TO=lucas@strobehq.com

# Cloudflare Turnstile. For local testing, Cloudflare's always-pass test keys are
# 1x00000000000000000000AA (site) and 1x0000000000000000000000000000000AA (secret).
# Without a secret key, verification is skipped in development and fails closed in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string, e.g. `openssl rand -hex 32`. Used to hash IPs for the rate limit.
IP_HASH_SALT=

# Optional. Signs the 30-minute token that lets the success screen's "Help me prepare for our
# call" form update the lead it just created. Falls back to IP_HASH_SALT. With neither set,
# production hides that optional step.
LEAD_TOKEN_SECRET=

# Cal.com event path, e.g. strobe/walkthrough. Without it, the walkthrough buttons scroll to the form
# and the success state shows only the message.
NEXT_PUBLIC_CAL_LINK=
